{
  "appName": "MittrCraft Dev",
  "linuxDesktopName": "mittrcraft-dev.desktop",
  "deepLinkProtocol": "mittrcraft-dev",
  "appUserModelId": {
    "packaged": "dev.mittrcraft.desktop.dev",
    "dev": "dev.mittrcraft.desktop.dev"
  },
  "desktopPort": 57133,
  "links": {
    "bugReport": null,
    "ideas": null,
    "discord": null
  },
  "updaterFeed": null,
  "splashSvg": "splash.svg",
  "env": {
    "OPENCHAMBER_DATA_DIR": "~/.config/mittrcraft-dev",
    "OPENCODE_CONFIG_DIR": "~/.config/mittrcraft-dev/engine/opencode",
    "OPENCHAMBER_POLICY_FILE": "/Library/Application Support/MittrCraft Dev/policy.json",
    "OPENCHAMBER_MANAGED_PROCESS_REGISTRY": "~/.config/mittrcraft-dev/managed-opencode",
    "OPENCHAMBER_UPDATE_CHECK_DISABLED": "1",
    "MITTRCRAFT_ENGINE_HOME": "~/.config/mittrcraft-dev/engine",
    "MITTRCRAFT_DEEP_LINK_SCHEME": "mittrcraft-dev"
  },
  "envDefaults": {
    "MITTRCRAFT_BROKER_URL": "https://api-dev.mittr.asia"
  },
  "ensureDirs": [
    "~/.config/mittrcraft-dev/projects",
    "~/.config/mittrcraft-dev/themes",
    "~/.config/mittrcraft-dev/speech-models"
  ],
  "serverPlugins": [
    "product-plugins/mittr-server.mjs"
  ],
  "serverReportsAppVersion": true
}
