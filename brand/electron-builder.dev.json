{
  "appId": "dev.mittrcraft.desktop.dev",
  "productName": "MittrCraft Dev",
  "extraMetadata": {
    "version": "2.1.1+mittr.1"
  },
  "protocols": [
    {
      "name": "MittrCraft Dev",
      "schemes": [
        "mittrcraft-dev"
      ]
    }
  ],
  "files": [
    "product-plugins/**",
    {
      "from": ".product",
      "to": ".",
      "filter": [
        "product.json"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "../../brand/icons/icon.ico",
      "to": "icons/icon.ico"
    },
    {
      "from": "../../brand/icons/icon.png",
      "to": "icons/icon.png"
    },
    {
      "from": "../../brand/icons/tray",
      "to": "icons/tray"
    },
    {
      "from": "resources/icons/tray/status",
      "to": "icons/tray/status"
    }
  ],
  "afterPack": null,
  "mac": {
    "icon": "../../brand/icons/icon.icns",
    "extendInfo": {
      "CFBundleIconName": null,
      "NSLocalNetworkUsageDescription": "MittrCraft Dev needs access to devices and services on your local network."
    }
  },
  "win": {
    "icon": "../../brand/icons/icon.ico"
  },
  "linux": {
    "icon": "../../brand/icons/app-icon.svg",
    "executableName": "mittrcraft-dev",
    "desktop": {
      "entry": {
        "Name": "MittrCraft Dev",
        "Comment": "Desktop runtime for MittrCraft Dev",
        "Icon": "mittrcraft-dev",
        "StartupWMClass": "mittrcraft-dev"
      }
    }
  },
  "nsis": {
    "installerIcon": "../../brand/icons/icon.ico",
    "uninstallerIcon": "../../brand/icons/icon.ico",
    "installerHeaderIcon": "../../brand/icons/icon.ico"
  },
  "publish": null
}
