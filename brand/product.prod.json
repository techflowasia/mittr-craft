{
  "appName": "MittrCraft",
  "linuxDesktopName": "mittrcraft.desktop",
  "deepLinkProtocol": "mittrcraft",
  "appUserModelId": {
    "packaged": "dev.mittrcraft.desktop",
    "dev": "dev.mittrcraft.desktop.dev"
  },
  "desktopPort": 57123,
  "links": {
    "bugReport": null,
    "ideas": null,
    "discord": null
  },
  "updaterFeed": null,
  "splashSvg": "splash.svg",
  "env": {
    "OPENCHAMBER_DATA_DIR": "~/.config/mittrcraft",
    "OPENCODE_CONFIG_DIR": "~/.config/mittrcraft/engine/opencode",
    "OPENCHAMBER_POLICY_FILE": "/Library/Application Support/MittrCraft/policy.json",
    "OPENCHAMBER_MANAGED_PROCESS_REGISTRY": "~/.config/mittrcraft/managed-opencode"
  },
  "ensureDirs": [
    "~/.config/mittrcraft/projects",
    "~/.config/mittrcraft/themes",
    "~/.config/mittrcraft/speech-models"
  ],
  "serverPlugins": [
    "product-plugins/mittr-server.mjs"
  ]
}
