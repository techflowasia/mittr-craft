+export const PROJECT_DIR_NAMES = [".mittr", ".opencode"] as const
+export const PROJECT_CONFIG_NAMES = ["mittr", "opencode"] as const
+export const PROJECT_DIR_PRIMARY = PROJECT_DIR_NAMES[0]
