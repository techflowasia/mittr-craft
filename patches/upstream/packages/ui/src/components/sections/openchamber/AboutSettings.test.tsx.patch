+import { afterAll, describe, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+const browser = new Window({ url: 'http://localhost/' });
+Object.assign(globalThis, {
+  window: browser, document: browser.document, navigator: browser.navigator,
+  localStorage: browser.localStorage, sessionStorage: browser.sessionStorage,
+  Node: browser.Node, Element: browser.Element, HTMLElement: browser.HTMLElement,
+  HTMLButtonElement: browser.HTMLButtonElement, Event: browser.Event, CustomEvent: browser.CustomEvent, MouseEvent: browser.MouseEvent,
+  getComputedStyle: browser.getComputedStyle.bind(browser),
+  requestAnimationFrame: browser.requestAnimationFrame.bind(browser),
+  cancelAnimationFrame: browser.cancelAnimationFrame.bind(browser),
+  IS_REACT_ACT_ENVIRONMENT: true,
+});
+
+const realFetch = globalThis.fetch;
+const engineChecks: string[] = [];
+let installation: string | null = null;
+globalThis.fetch = async (input: RequestInfo | URL) => {
+  const url = String(input);
+  if (url.includes('/api/opencode/upgrade')) engineChecks.push(url);
+  if (url.includes('/api/opencode/compatibility') && installation) {
+    return new Response(JSON.stringify({ state: 'compatible', version: '2.3.2', installation, canInstall: false }), { headers: { 'Content-Type': 'application/json' } });
+  }
+  return new Response('{}', { status: 503, headers: { 'Content-Type': 'application/json' } });
+};
+
+mock.module('@/components/ui/AboutLogo', () => ({ AboutLogo: () => null }));
+
+const { AboutSettings, LinkIfSet } = await import('./AboutSettings');
+const { useUpdateStore } = await import('@/stores/useUpdateStore');
+const { I18nProvider } = await import('@/lib/i18n');
+
+afterAll(() => {
+  globalThis.fetch = realFetch;
+  browser.close();
+});
+
+const render = async () => {
+  const container = document.createElement('div');
+  document.body.append(container);
+  const root = createRoot(container);
+  await act(async () => root.render(<I18nProvider><AboutSettings /></I18nProvider>));
+  for (let turn = 0; turn < 20; turn += 1) await act(async () => { await Promise.resolve(); });
+  return {
+    container,
+    buttons: () => [...container.querySelectorAll('button')].map((button) => button.textContent?.trim() ?? ''),
+    unmount: async () => {
+      await act(async () => root.unmount());
+      container.remove();
+    },
+  };
+};
+
+// What the desktop shell answers an update check with when the build has no
+// update channel. The extra field is not part of UpdateInfo, which is why it
+// is a plain object rather than a typed literal.
+const noChannelAnswer = { available: false, currentVersion: '2.1.1', updatesDisabled: true };
+
+describe('About page update controls', () => {
+  test('a build with no update channel shows the engine check and never "up to date"', async () => {
+    useUpdateStore.setState({
+      runtimeType: 'desktop',
+      available: false,
+      checking: false,
+      error: null,
+      info: noChannelAnswer,
+    });
+    const page = await render();
+    try {
+      expect(page.buttons()).toContain('Check updates');
+      expect(page.buttons()).not.toContain('Check for updates');
+      expect(page.container.textContent).not.toContain('Up to date');
+
+      const before = engineChecks.length;
+      const engineButton = [...page.container.querySelectorAll('button')].find((button) => button.textContent?.trim() === 'Check updates');
+      await act(async () => {
+        engineButton?.click();
+      });
+      expect(engineChecks.length).toBe(before + 1);
+      expect(useUpdateStore.getState().checking).toBe(false);
+    } finally {
+      await page.unmount();
+    }
+  });
+
+  test('a build with no update channel offers no engine check where its engine is bundled, since only the app can update that one', async () => {
+    useUpdateStore.setState({ runtimeType: 'desktop', available: false, checking: false, error: null, info: noChannelAnswer });
+    for (const [kind, shown] of [['bundled', false], ['managed', true], ['external', true]] as const) {
+      installation = kind;
+      const page = await render();
+      try {
+        expect({ kind, shown: page.buttons().includes('Check updates') }).toEqual({ kind, shown });
+        expect(page.buttons()).not.toContain('Check for updates');
+      } finally {
+        installation = null;
+        await page.unmount();
+      }
+    }
+  });
+
+  test('the phone layout hides the engine check for a bundled engine too', async () => {
+    useUpdateStore.setState({ runtimeType: 'desktop', available: false, checking: false, error: null, info: noChannelAnswer });
+    const width = browser.innerWidth;
+    browser.happyDOM.setViewport({ width: 390 });
+    Object.defineProperty(browser.navigator, 'maxTouchPoints', { configurable: true, value: 1 });
+    try {
+      for (const [kind, shown] of [['bundled', false], ['managed', true]] as const) {
+        installation = kind;
+        const page = await render();
+        try {
+          expect(page.container.querySelector('.text-center')).not.toBeNull();
+          expect({ kind, shown: page.buttons().includes('Check updates') }).toEqual({ kind, shown });
+        } finally {
+          installation = null;
+          await page.unmount();
+        }
+      }
+    } finally {
+      Reflect.deleteProperty(browser.navigator, 'maxTouchPoints');
+      browser.happyDOM.setViewport({ width });
+    }
+  });
+
+  test('a build with an update channel keeps the app check', async () => {
+    useUpdateStore.setState({
+      runtimeType: 'desktop',
+      available: false,
+      checking: false,
+      error: null,
+      info: { available: false, currentVersion: '2.1.1' },
+    });
+    const page = await render();
+    try {
+      expect(page.buttons()).toContain('Check for updates');
+      expect(page.container.textContent).toContain('Up to date');
+    } finally {
+      await page.unmount();
+    }
+  });
+});
+
+describe('About page links', () => {
+  const renderLinks = async (element: React.ReactElement) => {
+    const container = document.createElement('div');
+    document.body.append(container);
+    const root = createRoot(container);
+    await act(async () => root.render(element));
+    const anchors = [...container.querySelectorAll('a')].map((anchor) => ({
+      href: anchor.getAttribute('href'),
+      target: anchor.getAttribute('target'),
+      rel: anchor.getAttribute('rel'),
+      text: anchor.textContent,
+    }));
+    await act(async () => root.unmount());
+    container.remove();
+    return anchors;
+  };
+
+  test('a link with an address opens it in a new window', async () => {
+    expect(await renderLinks(<LinkIfSet href="https://example.com/project">Project</LinkIfSet>)).toEqual([
+      { href: 'https://example.com/project', target: '_blank', rel: 'noopener noreferrer', text: 'Project' },
+    ]);
+  });
+
+  test('a link whose address a build blanked is not drawn', async () => {
+    expect(await renderLinks(<div><LinkIfSet href="">Project</LinkIfSet><LinkIfSet>Chat</LinkIfSet></div>)).toEqual([]);
+  });
+});
