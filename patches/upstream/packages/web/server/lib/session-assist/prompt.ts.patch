+import { isString } from '../shared/object-guards.js';
 import { excerpt } from './context.js';
 import type { AssistTargets, AssistTurn } from './contracts.js';
 
 const MAX_PROMPT_CHARS = 32_000;
 
+export interface SuggestionStyle {
+  suggestionRules: () => string[];
+}
+
+let suggestionStyle: { style: SuggestionStyle } | null = null;
+
+export function registerSuggestionStyle(style: SuggestionStyle) {
+  if (!(style?.suggestionRules instanceof Function)) throw new TypeError('A suggestion style needs a suggestionRules() function');
+  if (suggestionStyle) throw new Error('A suggestion style is already registered');
+  const entry = { style };
+  suggestionStyle = entry;
+  return () => {
+    if (suggestionStyle === entry) suggestionStyle = null;
+  };
+}
+
+const registeredSuggestionRules = (): string[] | null => {
+  if (!suggestionStyle) return null;
+  let rules: string[];
+  try {
+    rules = suggestionStyle.style.suggestionRules();
+  } catch {
+    return null;
+  }
+  if (!Array.isArray(rules) || rules.length === 0) return null;
+  const usable: string[] = [];
+  for (const rule of rules) {
+    if (!isString(rule) || rule.trim() === '') return null;
+    usable.push(rule);
+  }
+  return usable;
+};
